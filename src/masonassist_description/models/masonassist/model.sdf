<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="masonassist">

    <!-- ========================================================
         base_link
         Root of the model. Posed at the locked base_footprint -> base_link
         offset (xyz="0 0 0.07683" rpy="0 0 0") so the model's own root frame
         plays the role of base_footprint as the ground reference, exactly as
         validated in the /tmp Test 3 probe.
         Visual/collision mesh transform is copied verbatim from
         urdf/masonassist.urdf.xacro (chassis link) - LOCKED, not altered.
         ======================================================== -->
    <link name="base_link">
      <pose>0 0 0.07683 0 0 0</pose>

      <inertial>
        <mass>80.0</mass>
        <inertia>
          <ixx>5.0</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>5.0</iyy><iyz>0.0</iyz>
          <izz>5.0</izz>
        </inertia>
      </inertial>

      <visual name="chassis_visual">
        <pose>0 0 0.1525 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://masonassist_description/meshes/chassis.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <!-- Construction-equipment yellow, so the robot reads as
             identifiable site machinery rather than default grey.
             Visual only - geometry/scale/collision above are untouched. -->
        <material>
          <ambient>0.85 0.6 0.05 1</ambient>
          <diffuse>0.9 0.65 0.08 1</diffuse>
          <specular>0.3 0.25 0.1 1</specular>
        </material>
      </visual>

      <!-- Payload deck: a flat plate visual sitting on the chassis roof,
           well within the chassis's own known footprint (x in
           [-0.3625,0.3625], roof at local z=0.165 per the sensor-mount
           comment above) - visual only, no new collision, so the
           robot's actual collision geometry/footprint is unchanged. -->
      <visual name="payload_deck_visual">
        <pose>0 0 0.195 0 0 0</pose>
        <geometry>
          <box><size>0.55 0.4 0.06</size></box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.22 1</ambient>
          <diffuse>0.25 0.25 0.27 1</diffuse>
        </material>
      </visual>

      <!-- Visual-only marker at the LiDAR's real mounting pose (see the
           sensor element below - exact same pose, not a new location),
           so the sensor is actually visible rather than invisible. -->
      <visual name="lidar_housing_visual">
        <pose>0.30 0 0.19 0 0 0</pose>
        <geometry>
          <cylinder><radius>0.035</radius><length>0.05</length></cylinder>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>

      <!-- Small front-facing marker so the robot's heading/orientation
           is obvious at a glance in the GUI, matching the chassis's own
           +X forward convention. -->
      <visual name="heading_marker_visual">
        <pose>0.36 0 0.17 0 0 0</pose>
        <geometry>
          <box><size>0.03 0.15 0.03</size></box>
        </geometry>
        <material>
          <ambient>0.9 0.1 0.1 1</ambient>
          <diffuse>0.95 0.15 0.15 1</diffuse>
        </material>
      </visual>

      <!-- Body panels: visual-only thin plates closing the front, rear
           and both sides of the chassis's own known footprint (X in
           [-0.3625,0.3625], Z in [0,0.165], per the comment above) so
           the robot reads as an enclosed transporter body rather than
           an open skeletal frame. Y half-width (0.2) matches
           payload_deck_visual exactly, which is already proven clear
           of both tracks - no new collision, no change to the
           chassis/track geometry, joints or sensor pose. -->
      <visual name="body_panel_front">
        <pose>0.3525 0 0.0925 0 0 0</pose>
        <geometry><box><size>0.02 0.4 0.145</size></box></geometry>
        <material>
          <ambient>0.82 0.58 0.06 1</ambient>
          <diffuse>0.87 0.63 0.08 1</diffuse>
          <specular>0.3 0.25 0.1 1</specular>
        </material>
      </visual>
      <visual name="body_panel_rear">
        <pose>-0.3525 0 0.0925 0 0 0</pose>
        <geometry><box><size>0.02 0.4 0.145</size></box></geometry>
        <material>
          <ambient>0.82 0.58 0.06 1</ambient>
          <diffuse>0.87 0.63 0.08 1</diffuse>
          <specular>0.3 0.25 0.1 1</specular>
        </material>
      </visual>
      <visual name="body_panel_left">
        <pose>0 0.19 0.0925 0 0 0</pose>
        <geometry><box><size>0.725 0.02 0.145</size></box></geometry>
        <material>
          <ambient>0.82 0.58 0.06 1</ambient>
          <diffuse>0.87 0.63 0.08 1</diffuse>
          <specular>0.3 0.25 0.1 1</specular>
        </material>
      </visual>
      <visual name="body_panel_right">
        <pose>0 -0.19 0.0925 0 0 0</pose>
        <geometry><box><size>0.725 0.02 0.145</size></box></geometry>
        <material>
          <ambient>0.82 0.58 0.06 1</ambient>
          <diffuse>0.87 0.63 0.08 1</diffuse>
          <specular>0.3 0.25 0.1 1</specular>
        </material>
      </visual>

      <collision name="chassis_collision">
        <pose>0 0 0.1525 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://masonassist_description/meshes/chassis.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </collision>

      <!-- ========================================================
           2D planar LiDAR, upper/front-center of the chassis.
           Chassis spans X in [-0.3625, 0.3625], Z in [0, 0.165] in the
           base_link frame (from the locked chassis geometry) - 0.30 m
           forward keeps the sensor comfortably within the front edge,
           0.19 m up clears the 0.165 m chassis roof by 25 mm. Chassis
           geometry itself is unchanged; this only adds a sensor pose.
           type="gpu_lidar" chosen over the plain "lidar" sensor type:
           verified directly in this installed Gazebo Harmonic 8.11.0 -
           a plain type="lidar" sensor produced no topic at all (silent,
           no error), while type="gpu_lidar" worked correctly.
           ======================================================== -->
      <sensor name="gpu_lidar" type="gpu_lidar">
        <pose>0.30 0 0.19 0 0 0</pose>
        <topic>scan_raw</topic>
        <update_rate>10</update_rate>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.1</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </link>

    <!-- ========================================================
         left_track
         Rigid track assembly. Joint origin xyz="0 0.32775 0" reproduces
         track_separation/2 from the Xacro (0.6555 / 2). Mesh transform is
         the LOCKED, experimentally-validated track transform - not altered.
         Friction surface (mu/mu2/fdir1) matches the configuration already
         proven to produce stable, directionally-correct propulsion in the
         /tmp Test 3 probe - carried over unchanged, not tuned here.
         ======================================================== -->
    <link name="left_track">
      <pose>0 0.32775 0.07683 0 0 0</pose>

      <inertial>
        <mass>10.0</mass>
        <inertia>
          <ixx>0.5</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>0.5</iyy><iyz>0.0</iyz>
          <izz>0.5</izz>
        </inertia>
      </inertial>

      <visual name="left_track_visual">
        <pose>-0.24605 -0.06752 0.05185 -1.1687 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://masonassist_description/meshes/left_track.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.11 1</ambient>
          <diffuse>0.12 0.12 0.13 1</diffuse>
        </material>
      </visual>

      <collision name="left_track_collision">
        <pose>-0.24605 -0.06752 0.05185 -1.1687 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://masonassist_description/meshes/left_track.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.9</mu>
              <mu2>150</mu2>
              <fdir1>0 1 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
    <joint name="left_track_joint" type="fixed">
      <parent>base_link</parent>
      <child>left_track</child>
    </joint>

    <!-- ========================================================
         right_track - mirrored, same locked mesh transform and
         friction configuration as left_track.
         ======================================================== -->
    <link name="right_track">
      <pose>0 -0.32775 0.07683 0 0 0</pose>

      <inertial>
        <mass>10.0</mass>
        <inertia>
          <ixx>0.5</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>0.5</iyy><iyz>0.0</iyz>
          <izz>0.5</izz>
        </inertia>
      </inertial>

      <visual name="right_track_visual">
        <pose>-0.24605 -0.06752 0.05185 -1.1687 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://masonassist_description/meshes/right_track.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.11 1</ambient>
          <diffuse>0.12 0.12 0.13 1</diffuse>
        </material>
      </visual>

      <collision name="right_track_collision">
        <pose>-0.24605 -0.06752 0.05185 -1.1687 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://masonassist_description/meshes/right_track.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.9</mu>
              <mu2>150</mu2>
              <fdir1>0 1 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
    <joint name="right_track_joint" type="fixed">
      <parent>base_link</parent>
      <child>right_track</child>
    </joint>

    <!-- ========================================================
         Tracked-vehicle propulsion plugins - the experimentally
         verified configuration from the /tmp Test 3 feasibility test.
         tracks_height intentionally omitted: the installed
         gz-sim8-tracked-vehicle-system build ignores it (locked finding).
         ======================================================== -->
    <plugin name="gz::sim::systems::TrackedVehicle" filename="gz-sim-tracked-vehicle-system">
      <left_track><link>left_track</link></left_track>
      <right_track><link>right_track</link></right_track>
      <tracks_separation>0.6555</tracks_separation>
      <steering_efficiency>0.5</steering_efficiency>
    </plugin>

    <plugin name="gz::sim::systems::TrackController" filename="gz-sim-track-controller-system">
      <link>left_track</link>
      <track_orientation>0 0 0</track_orientation>
      <min_velocity>-1.0</min_velocity>
      <max_velocity>1.0</max_velocity>
    </plugin>

    <!-- Odometry source for /odom. TrackedVehicle's own odometry (still
         published on /model/masonassist/odometry, no longer bridged) is
         dead-reckoned from commanded track speeds and ignores real slip:
         measured against Gazebo ground truth after ~80 s of skid-steer
         turning/recovery it was off by ~1.7 m and ~35 deg, which made
         VFH+ steer from a wrong pose. OdometryPublisher derives odometry
         from the model's actual simulated motion. In simulation this is
         effectively perfect odometry - real hardware would need proper
         localization instead. -->
    <plugin name="gz::sim::systems::OdometryPublisher" filename="gz-sim-odometry-publisher-system">
      <dimensions>2</dimensions>
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_publish_frequency>30</odom_publish_frequency>
      <odom_topic>/model/masonassist/odometry_sim</odom_topic>
      <tf_topic>/model/masonassist/odometry_sim/tf</tf_topic>
    </plugin>

    <plugin name="gz::sim::systems::TrackController" filename="gz-sim-track-controller-system">
      <link>right_track</link>
      <track_orientation>0 0 0</track_orientation>
      <min_velocity>-1.0</min_velocity>
      <max_velocity>1.0</max_velocity>
    </plugin>

  </model>
</sdf>
