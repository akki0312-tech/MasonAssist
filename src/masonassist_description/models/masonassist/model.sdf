<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="masonassist">

    <!-- ========================================================
         base_link
         Root of the model. Posed at the locked base_footprint -> base_link
         offset (xyz="0 0 0.07683" rpy="0 0 0") so the model's own root frame
         plays the role of base_footprint as the ground reference, exactly as
         validated in the /tmp Test 3 probe.
         Visual/collision mesh transform is copied verbatim from
         urdf/masonassist.urdf.xacro (chassis link) - LOCKED, not altered.
         ======================================================== -->
    <link name="base_link">
      <pose>0 0 0.07683 0 0 0</pose>

      <inertial>
        <mass>80.0</mass>
        <inertia>
          <ixx>5.0</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>5.0</iyy><iyz>0.0</iyz>
          <izz>5.0</izz>
        </inertia>
      </inertial>

      <visual name="chassis_visual">
        <pose>0 0 0.1525 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://masonassist_description/meshes/chassis.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>

      <collision name="chassis_collision">
        <pose>0 0 0.1525 1.5708 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://masonassist_description/meshes/chassis.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </collision>

      <!-- ========================================================
           2D planar LiDAR, upper/front-center of the chassis.
           Chassis spans X in [-0.3625, 0.3625], Z in [0, 0.165] in the
           base_link frame (from the locked chassis geometry) - 0.30 m
           forward keeps the sensor comfortably within the front edge,
           0.19 m up clears the 0.165 m chassis roof by 25 mm. Chassis
           geometry itself is unchanged; this only adds a sensor pose.
           type="gpu_lidar" chosen over the plain "lidar" sensor type:
           verified directly in this installed Gazebo Harmonic 8.11.0 -
           a plain type="lidar" sensor produced no topic at all (silent,
           no error), while type="gpu_lidar" worked correctly.
           ======================================================== -->
      <sensor name="gpu_lidar" type="gpu_lidar">
        <pose>0.30 0 0.19 0 0 0</pose>
        <topic>scan_raw</topic>
        <update_rate>10</update_rate>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.1</min>
            <max>10.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
      </sensor>
    </link>

    <!-- ========================================================
         left_track
         Rigid track assembly. Joint origin xyz="0 0.32775 0" reproduces
         track_separation/2 from the Xacro (0.6555 / 2). Mesh transform is
         the LOCKED, experimentally-validated track transform - not altered.
         Friction surface (mu/mu2/fdir1) matches the configuration already
         proven to produce stable, directionally-correct propulsion in the
         /tmp Test 3 probe - carried over unchanged, not tuned here.
         ======================================================== -->
    <link name="left_track">
      <pose>0 0.32775 0.07683 0 0 0</pose>

      <inertial>
        <mass>10.0</mass>
        <inertia>
          <ixx>0.5</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>0.5</iyy><iyz>0.0</iyz>
          <izz>0.5</izz>
        </inertia>
      </inertial>

      <visual name="left_track_visual">
        <pose>-0.24605 -0.06752 0.05185 -1.1687 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://masonassist_description/meshes/left_track.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>

      <collision name="left_track_collision">
        <pose>-0.24605 -0.06752 0.05185 -1.1687 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://masonassist_description/meshes/left_track.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.9</mu>
              <mu2>150</mu2>
              <fdir1>0 1 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
    <joint name="left_track_joint" type="fixed">
      <parent>base_link</parent>
      <child>left_track</child>
    </joint>

    <!-- ========================================================
         right_track - mirrored, same locked mesh transform and
         friction configuration as left_track.
         ======================================================== -->
    <link name="right_track">
      <pose>0 -0.32775 0.07683 0 0 0</pose>

      <inertial>
        <mass>10.0</mass>
        <inertia>
          <ixx>0.5</ixx><ixy>0.0</ixy><ixz>0.0</ixz>
          <iyy>0.5</iyy><iyz>0.0</iyz>
          <izz>0.5</izz>
        </inertia>
      </inertial>

      <visual name="right_track_visual">
        <pose>-0.24605 -0.06752 0.05185 -1.1687 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://masonassist_description/meshes/right_track.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>

      <collision name="right_track_collision">
        <pose>-0.24605 -0.06752 0.05185 -1.1687 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://masonassist_description/meshes/right_track.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.9</mu>
              <mu2>150</mu2>
              <fdir1>0 1 0</fdir1>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
    <joint name="right_track_joint" type="fixed">
      <parent>base_link</parent>
      <child>right_track</child>
    </joint>

    <!-- ========================================================
         Tracked-vehicle propulsion plugins - the experimentally
         verified configuration from the /tmp Test 3 feasibility test.
         tracks_height intentionally omitted: the installed
         gz-sim8-tracked-vehicle-system build ignores it (locked finding).
         ======================================================== -->
    <plugin name="gz::sim::systems::TrackedVehicle" filename="gz-sim-tracked-vehicle-system">
      <left_track><link>left_track</link></left_track>
      <right_track><link>right_track</link></right_track>
      <tracks_separation>0.6555</tracks_separation>
      <steering_efficiency>0.5</steering_efficiency>
    </plugin>

    <plugin name="gz::sim::systems::TrackController" filename="gz-sim-track-controller-system">
      <link>left_track</link>
      <track_orientation>0 0 0</track_orientation>
      <min_velocity>-1.0</min_velocity>
      <max_velocity>1.0</max_velocity>
    </plugin>

    <plugin name="gz::sim::systems::TrackController" filename="gz-sim-track-controller-system">
      <link>right_track</link>
      <track_orientation>0 0 0</track_orientation>
      <min_velocity>-1.0</min_velocity>
      <max_velocity>1.0</max_velocity>
    </plugin>

  </model>
</sdf>
