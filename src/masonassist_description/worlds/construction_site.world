      <link name="link"><visual name="visual"><geometry><box><size>1.6 0.05 0.08</size></box></geometry>
        <material><ambient>0.9 0.75 0.1 1</ambient><diffuse>0.9 0.75 0.1 1</diffuse></material></visual>
      </link></model>

    <model name="rubble_1"><static>true</static><pose>-2 3 0.15 0.2 0.1 0.5</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.4 0.5 0.3</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.4 0.5 0.3</size></box></geometry>
          <material><ambient>0.5 0.48 0.45 1</ambient><diffuse>0.5 0.48 0.45 1</diffuse></material></visual>
      </link></model>
    <model name="rubble_2"><static>true</static><pose>-1.6 3.3 0.12 0.1 -0.2 1.1</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.35 0.3 0.25</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.35 0.3 0.25</size></box></geometry>
          <material><ambient>0.5 0.48 0.45 1</ambient><diffuse>0.5 0.48 0.45 1</diffuse></material></visual>
      </link></model>

    <!-- ============================================================
         ZONE E - WORKERS. Two plain (non-static) models, NOT Gazebo
         actors - confirmed by direct test that this installed Gazebo
         Harmonic drops primitive visuals on actors without a skin
         mesh, and separately that scripted actor trajectories are not
         physics-collision-aware regardless (see
         https://gazebosim.org/docs/harmonic/actors/ - "animated actors
         ... do not participate in physics"). These are teleported by
         scripts/worker_mover.py via the real /world/.../set_pose
         service. worker_mover.py now carries an explicit obstacle
         registry (hand-derived from this file's own coordinates, see
         its own comments) and validates every waypoint against it
         before accepting a patrol path - this is what caught and fixed
         the wall-crossing defect from the previous iteration
         (worker_2's old lane ran straight through partial_wall_1).
         Lane geometry:
           worker_1: y=-5.5, x in [-6.5, 6.3] - open south lane between
                     Zone C and the Zone B storage strip (y~-7).
           worker_2: y=7.0,  x in [-6.5, 1.2] - open north lane between
                     the perimeter wall and Zone A's building footprint.
         Both verified clear (0.3m margin) of every obstacle above and
         of the robot's spawn point before this file was written.
         ============================================================ -->
    <model name="worker_1">
      <pose>-6.5 -5.5 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>0 0 0.9 0 0 0</pose>
          <geometry><box><size>0.5 0.35 1.8</size></box></geometry>
        </collision>
        <visual name="helmet_dome"><pose>0 0 1.62 0 0 0</pose>
          <geometry><sphere><radius>0.125</radius></sphere></geometry>
          <material><ambient>0.95 0.78 0.05 1</ambient><diffuse>0.95 0.78 0.05 1</diffuse></material></visual>
        <visual name="helmet_brim"><pose>0 0 1.56 0 0 0</pose>
          <geometry><cylinder><radius>0.15</radius><length>0.03</length></cylinder></geometry>
          <material><ambient>0.85 0.68 0.03 1</ambient><diffuse>0.85 0.68 0.03 1</diffuse></material></visual>
        <visual name="head"><pose>0 0 1.47 0 0 0</pose>
          <geometry><sphere><radius>0.1</radius></sphere></geometry>
          <material><ambient>0.76 0.57 0.44 1</ambient><diffuse>0.76 0.57 0.44 1</diffuse></material></visual>
        <visual name="torso"><pose>0 0 1.15 0 0 0</pose>
          <geometry><box><size>0.4 0.24 0.55</size></box></geometry>
          <material><ambient>0.1 0.13 0.4 1</ambient><diffuse>0.1 0.13 0.4 1</diffuse></material></visual>
        <visual name="vest"><pose>0 0 1.18 0 0 0</pose>
          <geometry><box><size>0.42 0.26 0.4</size></box></geometry>
          <material><ambient>0.95 0.45 0.05 1</ambient><diffuse>0.95 0.45 0.05 1</diffuse></material></visual>
        <visual name="vest_stripe"><pose>0 0 1.02 0 0 0</pose>
          <geometry><box><size>0.43 0.27 0.07</size></box></geometry>
          <material><ambient>0.95 0.95 0.9 1</ambient><diffuse>0.95 0.95 0.9 1</diffuse></material></visual>
        <visual name="arm_l"><pose>0.03 0.19 1.08 0.25 0 0</pose>
          <geometry><cylinder><radius>0.055</radius><length>0.48</length></cylinder></geometry>
          <material><ambient>0.95 0.45 0.05 1</ambient><diffuse>0.95 0.45 0.05 1</diffuse></material></visual>
        <visual name="arm_r"><pose>0.03 -0.19 1.08 -0.25 0 0</pose>
          <geometry><cylinder><radius>0.055</radius><length>0.48</length></cylinder></geometry>
          <material><ambient>0.95 0.45 0.05 1</ambient><diffuse>0.95 0.45 0.05 1</diffuse></material></visual>
        <visual name="leg_l"><pose>0 0.1 0.42 0 0 0</pose>
          <geometry><cylinder><radius>0.075</radius><length>0.78</length></cylinder></geometry>
          <material><ambient>0.15 0.17 0.22 1</ambient><diffuse>0.15 0.17 0.22 1</diffuse></material></visual>
        <visual name="leg_r"><pose>0 -0.1 0.42 0 0 0</pose>
          <geometry><cylinder><radius>0.075</radius><length>0.78</length></cylinder></geometry>
          <material><ambient>0.15 0.17 0.22 1</ambient><diffuse>0.15 0.17 0.22 1</diffuse></material></visual>
        <visual name="boot_l"><pose>0 0.1 0.04 0 0 0</pose>
          <geometry><box><size>0.14 0.1 0.08</size></box></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
        <visual name="boot_r"><pose>0 -0.1 0.04 0 0 0</pose>
          <geometry><box><size>0.14 0.1 0.08</size></box></geometry>
          <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
      </link>
    </model>

    <model name="worker_2">
