<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="masonassist_world">
    <!-- Physics parameters - identical to masonassist.world, unchanged -->
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.55 0.52 0.5 1</ambient>
      <background>0.62 0.68 0.75 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- Custom GUI config, copied/adapted from the bundled gz-sim8 example
         world visualize_contacts.sdf. Grid3D omitted; scene-level grid
         also explicitly disabled above. start_paused false so the demo
         runs immediately. Camera framed on the robot's main work area
         (Zone C), not a far satellite view, so the robot reads at a
         usable size by default. -->
    <gui fullscreen="false">
      <plugin filename="MinimalScene" name="3D View">
        <gz-gui>
          <title>3D View</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="string" key="state">docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.55 0.52 0.5</ambient_light>
        <background_color>0.62 0.68 0.75</background_color>
        <camera_pose>-5.5 -5.5 3.6 0 0.3 0.78</camera_pose>
      </plugin>
      <plugin filename="EntityContextMenuPlugin" name="Entity context menu">
        <gz-gui>
          <property key="state" type="string">floating</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="GzSceneManager" name="Scene Manager">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="InteractiveViewControl" name="Interactive view control">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="CameraTracking" name="Camera Tracking">
        <gz-gui>
          <property key="resizable" type="bool">false</property>
          <property key="width" type="double">5</property>
          <property key="height" type="double">5</property>
          <property key="state" type="string">floating</property>
          <property key="showTitleBar" type="bool">false</property>
        </gz-gui>
      </plugin>
      <plugin filename="WorldControl" name="World control">
        <gz-gui>
          <title>World control</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">72</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="left" target="left"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <play_pause>true</play_pause>
        <step>true</step>
        <start_paused>false</start_paused>
        <use_event>true</use_event>
      </plugin>
      <plugin filename="WorldStats" name="World stats">
        <gz-gui>
          <title>World stats</title>
          <property type="bool" key="showTitleBar">false</property>
          <property type="bool" key="resizable">false</property>
          <property type="double" key="height">110</property>
          <property type="double" key="width">290</property>
          <property type="double" key="z">1</property>
          <property type="string" key="state">floating</property>
          <anchors target="3D View">
            <line own="right" target="right"/>
            <line own="bottom" target="bottom"/>
          </anchors>
        </gz-gui>
        <sim_time>true</sim_time>
        <real_time>true</real_time>
        <real_time_factor>true</real_time_factor>
        <iterations>true</iterations>
      </plugin>
    </gui>

    <!-- Ground: compacted-soil/concrete-yard tone, no grid. A second,
         slightly varied patch breaks up the uniform flat color. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.4 0.36 0.3 1</ambient><diffuse>0.4 0.36 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="soil_patch_1"><static>true</static><pose>-4 -3 0.005 0 0 0.3</pose>
      <link name="link"><visual name="visual"><geometry><box><size>5 4 0.01</size></box></geometry>
        <material><ambient>0.36 0.31 0.24 1</ambient><diffuse>0.36 0.31 0.24 1</diffuse></material></visual>
      </link></model>
    <!-- Worn entrance path: lighter, compacted-looking strip leading in
         from the gate, and a darker tire/oil stain patch just inside it
         - both thin ground decals (no collision) for color variation. -->
    <model name="entrance_path"><static>true</static><pose>-6.2 0 0.005 0 0 0</pose>
      <link name="link"><visual name="visual"><geometry><box><size>3.4 1.8 0.01</size></box></geometry>
        <material><ambient>0.46 0.42 0.35 1</ambient><diffuse>0.46 0.42 0.35 1</diffuse></material></visual>
      </link></model>
    <model name="stain_patch_gate"><static>true</static><pose>-5.3 0.5 0.006 0 0 0.6</pose>
      <link name="link"><visual name="visual"><geometry><box><size>1.4 0.7 0.008</size></box></geometry>
        <material><ambient>0.26 0.24 0.21 1</ambient><diffuse>0.26 0.24 0.21 1</diffuse></material></visual>
      </link></model>

    <!-- Zone C work slab: poured concrete under the robot's main
         operating area -->
    <model name="concrete_slab">
      <static>true</static>
      <pose>-1 0 0.012 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>8 7 0.02</size></box></geometry>
          <material><ambient>0.6 0.59 0.56 1</ambient><diffuse>0.6 0.59 0.56 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Slab expansion-joint seams: thin dark strips flush on top of
         concrete_slab, dividing it into a visible 4x3 panel grid -
         visual only, no collision, so the slab's footprint/collision
         (and therefore OBSTACLES in worker_mover.py) is unchanged. -->
    <model name="slab_seams"><static>true</static><pose>-1 0 0.0225 0 0 0</pose>
      <link name="link">
        <visual name="v1"><pose>-2 0 0 0 0 0</pose><geometry><box><size>0.03 7 0.004</size></box></geometry>
          <material><ambient>0.38 0.37 0.35 1</ambient><diffuse>0.38 0.37 0.35 1</diffuse></material></visual>
        <visual name="v2"><pose>0 0 0 0 0 0</pose><geometry><box><size>0.03 7 0.004</size></box></geometry>
          <material><ambient>0.38 0.37 0.35 1</ambient><diffuse>0.38 0.37 0.35 1</diffuse></material></visual>
        <visual name="v3"><pose>2 0 0 0 0 0</pose><geometry><box><size>0.03 7 0.004</size></box></geometry>
          <material><ambient>0.38 0.37 0.35 1</ambient><diffuse>0.38 0.37 0.35 1</diffuse></material></visual>
        <visual name="h1"><pose>0 -1.5 0 0 0 0</pose><geometry><box><size>8 0.03 0.004</size></box></geometry>
          <material><ambient>0.38 0.37 0.35 1</ambient><diffuse>0.38 0.37 0.35 1</diffuse></material></visual>
        <visual name="h2"><pose>0 1.5 0 0 0 0</pose><geometry><box><size>8 0.03 0.004</size></box></geometry>
          <material><ambient>0.38 0.37 0.35 1</ambient><diffuse>0.38 0.37 0.35 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ============================================================
         ZONE D - SITE PERIMETER: boundary walls, corner columns, and a
         recognizable gate entrance in the west wall. Unchanged
         footprint from the previous iteration (already verified clear
         of every worker lane and the robot spawn point).
         ============================================================ -->
    <!-- Perimeter walls: each split into 3 stacked horizontal visual
         bands (base/mid/top) to read as weathered concrete rather than
         one flat shade - same technique already used on wall_a/wall_b's
         coursed brick. Collision box is a single unchanged box per
         wall, so OBSTACLES in worker_mover.py and its footprint are
         untouched. -->
    <model name="wall_north"><static>true</static><pose>0 8 0.75 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>16 0.3 1.5</size></box></geometry></collision>
        <visual name="base"><pose>0 0 -0.5 0 0 0</pose><geometry><box><size>16 0.3 0.5</size></box></geometry>
          <material><ambient>0.48 0.47 0.44 1</ambient><diffuse>0.48 0.47 0.44 1</diffuse></material></visual>
        <visual name="mid"><pose>0 0 0 0 0 0</pose><geometry><box><size>16 0.3 0.5</size></box></geometry>
          <material><ambient>0.58 0.57 0.55 1</ambient><diffuse>0.58 0.57 0.55 1</diffuse></material></visual>
        <visual name="top"><pose>0 0 0.5 0 0 0</pose><geometry><box><size>16 0.3 0.5</size></box></geometry>
          <material><ambient>0.65 0.64 0.61 1</ambient><diffuse>0.65 0.64 0.61 1</diffuse></material></visual>
      </link></model>
    <model name="wall_south"><static>true</static><pose>0 -8 0.75 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>16 0.3 1.5</size></box></geometry></collision>
        <visual name="base"><pose>0 0 -0.5 0 0 0</pose><geometry><box><size>16 0.3 0.5</size></box></geometry>
          <material><ambient>0.48 0.47 0.44 1</ambient><diffuse>0.48 0.47 0.44 1</diffuse></material></visual>
        <visual name="mid"><pose>0 0 0 0 0 0</pose><geometry><box><size>16 0.3 0.5</size></box></geometry>
          <material><ambient>0.58 0.57 0.55 1</ambient><diffuse>0.58 0.57 0.55 1</diffuse></material></visual>
        <visual name="top"><pose>0 0 0.5 0 0 0</pose><geometry><box><size>16 0.3 0.5</size></box></geometry>
          <material><ambient>0.65 0.64 0.61 1</ambient><diffuse>0.65 0.64 0.61 1</diffuse></material></visual>
      </link></model>
    <model name="wall_east"><static>true</static><pose>8 0 0.75 0 0 1.5708</pose>
      <link name="link"><collision name="collision"><geometry><box><size>16 0.3 1.5</size></box></geometry></collision>
        <visual name="base"><pose>0 0 -0.5 0 0 0</pose><geometry><box><size>16 0.3 0.5</size></box></geometry>
          <material><ambient>0.48 0.47 0.44 1</ambient><diffuse>0.48 0.47 0.44 1</diffuse></material></visual>
        <visual name="mid"><pose>0 0 0 0 0 0</pose><geometry><box><size>16 0.3 0.5</size></box></geometry>
          <material><ambient>0.58 0.57 0.55 1</ambient><diffuse>0.58 0.57 0.55 1</diffuse></material></visual>
        <visual name="top"><pose>0 0 0.5 0 0 0</pose><geometry><box><size>16 0.3 0.5</size></box></geometry>
          <material><ambient>0.65 0.64 0.61 1</ambient><diffuse>0.65 0.64 0.61 1</diffuse></material></visual>
      </link></model>
    <model name="wall_west_a"><static>true</static><pose>-8 4.5 0.75 0 0 1.5708</pose>
      <link name="link"><collision name="collision"><geometry><box><size>7 0.3 1.5</size></box></geometry></collision>
        <visual name="base"><pose>0 0 -0.5 0 0 0</pose><geometry><box><size>7 0.3 0.5</size></box></geometry>
          <material><ambient>0.48 0.47 0.44 1</ambient><diffuse>0.48 0.47 0.44 1</diffuse></material></visual>
        <visual name="mid"><pose>0 0 0 0 0 0</pose><geometry><box><size>7 0.3 0.5</size></box></geometry>
          <material><ambient>0.58 0.57 0.55 1</ambient><diffuse>0.58 0.57 0.55 1</diffuse></material></visual>
        <visual name="top"><pose>0 0 0.5 0 0 0</pose><geometry><box><size>7 0.3 0.5</size></box></geometry>
          <material><ambient>0.65 0.64 0.61 1</ambient><diffuse>0.65 0.64 0.61 1</diffuse></material></visual>
      </link></model>
    <model name="wall_west_b"><static>true</static><pose>-8 -4.5 0.75 0 0 1.5708</pose>
      <link name="link"><collision name="collision"><geometry><box><size>7 0.3 1.5</size></box></geometry></collision>
        <visual name="base"><pose>0 0 -0.5 0 0 0</pose><geometry><box><size>7 0.3 0.5</size></box></geometry>
          <material><ambient>0.48 0.47 0.44 1</ambient><diffuse>0.48 0.47 0.44 1</diffuse></material></visual>
        <visual name="mid"><pose>0 0 0 0 0 0</pose><geometry><box><size>7 0.3 0.5</size></box></geometry>
          <material><ambient>0.58 0.57 0.55 1</ambient><diffuse>0.58 0.57 0.55 1</diffuse></material></visual>
        <visual name="top"><pose>0 0 0.5 0 0 0</pose><geometry><box><size>7 0.3 0.5</size></box></geometry>
          <material><ambient>0.65 0.64 0.61 1</ambient><diffuse>0.65 0.64 0.61 1</diffuse></material></visual>
      </link></model>
    <model name="column_ne"><static>true</static><pose>7.85 7.85 1.0 0 0 0</pose>
      <link name="link"><visual name="visual"><geometry><box><size>0.3 0.3 2.0</size></box></geometry>
        <material><ambient>0.5 0.49 0.47 1</ambient><diffuse>0.5 0.49 0.47 1</diffuse></material></visual>
        <collision name="collision"><geometry><box><size>0.3 0.3 2.0</size></box></geometry></collision>
      </link></model>
    <model name="column_nw"><static>true</static><pose>-7.85 7.85 1.0 0 0 0</pose>
      <link name="link"><visual name="visual"><geometry><box><size>0.3 0.3 2.0</size></box></geometry>
        <material><ambient>0.5 0.49 0.47 1</ambient><diffuse>0.5 0.49 0.47 1</diffuse></material></visual>
        <collision name="collision"><geometry><box><size>0.3 0.3 2.0</size></box></geometry></collision>
      </link></model>
    <model name="column_se"><static>true</static><pose>7.85 -7.85 1.0 0 0 0</pose>
      <link name="link"><visual name="visual"><geometry><box><size>0.3 0.3 2.0</size></box></geometry>
        <material><ambient>0.5 0.49 0.47 1</ambient><diffuse>0.5 0.49 0.47 1</diffuse></material></visual>
        <collision name="collision"><geometry><box><size>0.3 0.3 2.0</size></box></geometry></collision>
      </link></model>
    <model name="gate_post_a"><static>true</static><pose>-8 1.3 1.0 0 0 0</pose>
      <link name="link"><visual name="visual"><geometry><box><size>0.3 0.3 2.0</size></box></geometry>
        <material><ambient>0.5 0.49 0.47 1</ambient><diffuse>0.5 0.49 0.47 1</diffuse></material></visual>
        <collision name="collision"><geometry><box><size>0.3 0.3 2.0</size></box></geometry></collision>
      </link></model>
    <model name="gate_post_b"><static>true</static><pose>-8 -1.3 1.0 0 0 0</pose>
      <link name="link"><visual name="visual"><geometry><box><size>0.3 0.3 2.0</size></box></geometry>
        <material><ambient>0.5 0.49 0.47 1</ambient><diffuse>0.5 0.49 0.47 1</diffuse></material></visual>
        <collision name="collision"><geometry><box><size>0.3 0.3 2.0</size></box></geometry></collision>
      </link></model>
    <model name="gate_sign"><static>true</static><pose>-8 0 1.9 0 0 1.5708</pose>
      <link name="link"><visual name="visual"><geometry><box><size>2.0 0.05 0.5</size></box></geometry>
        <material><ambient>0.85 0.65 0.05 1</ambient><diffuse>0.85 0.65 0.05 1</diffuse></material></visual>
      </link></model>

    <!-- ============================================================
         ZONE A - BUILDING STRUCTURE (NE quadrant, x:[2.85,7.2] y:[2.55,7.5]).
         An L-shaped unfinished masonry wall with a door gap (x 4.3-5.7)
         and a window gap (y 4.55-4.85), coursed brick visuals, two
         structural columns at the open corners. Kept well clear (by
         construction, verified below) of both worker lanes and the
         robot's main operating area.
         ============================================================ -->
    <model name="wall_a_left"><static>true</static><pose>3.65 2.7 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.3 0.3 1.2</size></box></geometry></collision>
        <visual name="c1"><pose>0 0 -0.42 0 0 0</pose><geometry><box><size>1.26 0.28 0.14</size></box></geometry>
          <material><ambient>0.62 0.25 0.18 1</ambient><diffuse>0.62 0.25 0.18 1</diffuse></material></visual>
        <visual name="c2"><pose>0 0 -0.25 0 0 0</pose><geometry><box><size>1.26 0.28 0.14</size></box></geometry>
          <material><ambient>0.58 0.23 0.16 1</ambient><diffuse>0.58 0.23 0.16 1</diffuse></material></visual>
        <visual name="c3"><pose>0 0 -0.08 0 0 0</pose><geometry><box><size>1.26 0.28 0.14</size></box></geometry>
          <material><ambient>0.64 0.26 0.19 1</ambient><diffuse>0.64 0.26 0.19 1</diffuse></material></visual>
        <visual name="c4"><pose>0 0 0.1 0 0 0</pose><geometry><box><size>1.26 0.28 0.18</size></box></geometry>
          <material><ambient>0.6 0.25 0.18 1</ambient><diffuse>0.6 0.25 0.18 1</diffuse></material></visual>
        <visual name="c5"><pose>0 0 0.32 0 0 0</pose><geometry><box><size>1.26 0.28 0.14</size></box></geometry>
          <material><ambient>0.63 0.26 0.18 1</ambient><diffuse>0.63 0.26 0.18 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_a_right"><static>true</static><pose>6.35 2.7 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.3 0.3 1.2</size></box></geometry></collision>
        <visual name="c1"><pose>0 0 -0.42 0 0 0</pose><geometry><box><size>1.26 0.28 0.14</size></box></geometry>
          <material><ambient>0.62 0.25 0.18 1</ambient><diffuse>0.62 0.25 0.18 1</diffuse></material></visual>
        <visual name="c2"><pose>0 0 -0.25 0 0 0</pose><geometry><box><size>1.26 0.28 0.14</size></box></geometry>
          <material><ambient>0.58 0.23 0.16 1</ambient><diffuse>0.58 0.23 0.16 1</diffuse></material></visual>
        <visual name="c3"><pose>0 0 -0.08 0 0 0</pose><geometry><box><size>1.26 0.28 0.14</size></box></geometry>
          <material><ambient>0.64 0.26 0.19 1</ambient><diffuse>0.64 0.26 0.19 1</diffuse></material></visual>
        <visual name="c4"><pose>0 0 0.1 0 0 0</pose><geometry><box><size>1.26 0.28 0.18</size></box></geometry>
          <material><ambient>0.6 0.25 0.18 1</ambient><diffuse>0.6 0.25 0.18 1</diffuse></material></visual>
        <visual name="c5"><pose>0 0 0.32 0 0 0</pose><geometry><box><size>1.26 0.28 0.14</size></box></geometry>
          <material><ambient>0.63 0.26 0.18 1</ambient><diffuse>0.63 0.26 0.18 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_b_lower"><static>true</static><pose>3.0 3.7 0.6 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.7 0.3 1.2</size></box></geometry></collision>
        <visual name="c1"><pose>0 0 -0.42 0 0 0</pose><geometry><box><size>1.66 0.28 0.14</size></box></geometry>
          <material><ambient>0.6 0.59 0.56 1</ambient><diffuse>0.6 0.59 0.56 1</diffuse></material></visual>
        <visual name="c2"><pose>0 0 -0.2 0 0 0</pose><geometry><box><size>1.66 0.28 0.14</size></box></geometry>
          <material><ambient>0.63 0.62 0.59 1</ambient><diffuse>0.63 0.62 0.59 1</diffuse></material></visual>
        <visual name="c3"><pose>0 0 0.05 0 0 0</pose><geometry><box><size>1.66 0.28 0.2</size></box></geometry>
          <material><ambient>0.58 0.57 0.54 1</ambient><diffuse>0.58 0.57 0.54 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_b_upper"><static>true</static><pose>3.0 6.0 0.6 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.3 0.3 1.2</size></box></geometry></collision>
        <visual name="c1"><pose>0 0 -0.42 0 0 0</pose><geometry><box><size>2.26 0.28 0.14</size></box></geometry>
          <material><ambient>0.6 0.59 0.56 1</ambient><diffuse>0.6 0.59 0.56 1</diffuse></material></visual>
        <visual name="c2"><pose>0 0 -0.2 0 0 0</pose><geometry><box><size>2.26 0.28 0.14</size></box></geometry>
          <material><ambient>0.63 0.62 0.59 1</ambient><diffuse>0.63 0.62 0.59 1</diffuse></material></visual>
        <visual name="c3"><pose>0 0 0.05 0 0 0</pose><geometry><box><size>2.26 0.28 0.2</size></box></geometry>
          <material><ambient>0.58 0.57 0.54 1</ambient><diffuse>0.58 0.57 0.54 1</diffuse></material></visual>
      </link>
    </model>
    <model name="col_bld_1"><static>true</static><pose>7.0 2.7 0.75 0 0 0</pose>
      <link name="link"><visual name="visual"><geometry><box><size>0.5 0.5 1.5</size></box></geometry>
        <material><ambient>0.65 0.64 0.6 1</ambient><diffuse>0.65 0.64 0.6 1</diffuse></material></visual>
        <collision name="collision"><geometry><box><size>0.5 0.5 1.5</size></box></geometry></collision>
      </link></model>
    <model name="col_bld_2"><static>true</static><pose>3.0 7.3 0.75 0 0 0</pose>
      <link name="link"><visual name="visual"><geometry><box><size>0.5 0.5 1.5</size></box></geometry>
        <material><ambient>0.65 0.64 0.6 1</ambient><diffuse>0.65 0.64 0.6 1</diffuse></material></visual>
        <collision name="collision"><geometry><box><size>0.5 0.5 1.5</size></box></geometry></collision>
      </link></model>
    <model name="rebar_sticking_up"><static>true</static><pose>7.0 2.7 1.6 0 0 0</pose>
      <link name="link">
