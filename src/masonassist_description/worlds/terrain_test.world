    <model name="cross_slope_10"><static>true</static><pose>2.0000 41.4772 0.1620 0.174533 0.000000 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>10.0000 3.0000 0.2000</size></box></geometry><surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface></collision><visual name="v"><geometry><box><size>10.0000 3.0000 0.2000</size></box></geometry><material><ambient>0.62 0.6 0.56 1</ambient><diffuse>0.62 0.6 0.56 1</diffuse></material></visual></link></model>
